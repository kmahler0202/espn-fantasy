# Copy to espn.env (gitignored) and fill in.
# League ID: the number after leagueId= in your league's URL on fantasy.espn.com
ESPN_LEAGUE_ID=
# Season the league is in, e.g. 2026
ESPN_YEAR=
# Private leagues only: cookies from fantasy.espn.com (DevTools > Application > Cookies)
# espn_s2 works like a login token. Treat it like a password.
ESPN_S2=
# Keep the curly braces
ESPN_SWID=
